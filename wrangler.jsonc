{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "WHATSAPP_PHONE_NUMBER_ID": "1258284564037339"
  }
}
